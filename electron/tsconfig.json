{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": false,
    "baseUrl": ".",
    "outDir": "../dist-electron",
    "moduleResolution": "node",
    "resolveJsonModule": true
  },
  "include": [
    "main.ts",
    "preload.ts",
    "geminiService.ts",
    "groqService.ts",
    "openrouterService.ts",
    "routerService.ts",
    "screenshotService.ts",
    "storeService.ts",
    "nativeAudioService.ts",
    "models/**/*.ts"
  ]
}