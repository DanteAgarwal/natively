GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Free Router / Universal Gateway (Pollinations, Cerebras, Ollama, LiteLLM)
ROUTER_BASE_URL=https://text.pollinations.ai/openai
ROUTER_API_KEY=
ROUTER_MODEL=openai

OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# CLIProxy (OpenAI-compatible proxy that routes Claude calls — e.g. self-hosted cli-proxy-api)
# If unset, the app falls back to http://localhost:8317/v1 with a dummy key.
CLIPROXY_BASE_URL=http://localhost:8317/v1
CLIPROXY_API_KEY=sk-your-cliproxy-key-here

# Speech Providers (Optional - only one needed)
DEEPGRAM_API_KEY=your_deepgram_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here
AZURE_SPEECH_KEY=your_azure_key_here
AZURE_SPEECH_REGION=eastus
IBM_WATSON_API_KEY=your_ibm_key_here
IBM_WATSON_REGION=us-south

# Local AI Configuration
USE_OLLAMA=true
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Default Vision/Chat Model (Optional)
DEFAULT_MODEL=gemini-3.8-flash
